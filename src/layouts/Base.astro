---
/**
 * 모든 페이지의 공통 틀. 페이지를 추가할 때는 이 레이아웃으로 감싸기만 하면 된다.
 *
 * 애드센스·Search Console 값은 src/lib/site.js 의 google 에 넣으면 여기서 자동으로 붙는다.
 */
import { SITE, TOOLS, PAGES } from '../lib/site.js';
import '../styles/global.css';

const { title, description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const pageDesc = description ?? SITE.description;
// build.format='file' 이라 빌드 때 pathname 이 /tools/margin.html 로 들어온다. 사이트맵·링크와 같은 모양으로 맞춘다.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 구글 연동: 값은 src/lib/site.js 의 google 에서만 바꾼다. 비어 있으면 렌더링되지 않는다. -->
    {SITE.google.siteVerification && (
      <meta name="google-site-verification" content={SITE.google.siteVerification} />
    )}
    {SITE.google.adsenseClient && (
      <>
        <meta name="google-adsense-account" content={SITE.google.adsenseClient} />
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.google.adsenseClient}`}
          crossorigin="anonymous"
        ></script>
      </>
    )}
  </head>

  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">{SITE.name}</a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {TOOLS.map((t) => (
            <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>{t.short}</a>
          ))}
          <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>소개</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <nav class="foot-links" aria-label="안내">
          {PAGES.map((p) => <a href={p.href}>{p.title}</a>)}
        </nav>
        <p>
          계산 결과는 <strong>참고용</strong>입니다. 실제 수수료·세금은 마켓 계약 조건과
          사업자 유형에 따라 달라집니다. 중요한 결정은 반드시 실제 정산서와 세무 상담으로
          확인하세요.
        </p>
        <p>입력한 숫자는 브라우저 안에서만 계산되며 서버로 전송·저장되지 않습니다.</p>
        <p>© {new Date().getFullYear()} {SITE.author}. 문의: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </footer>
  </body>
</html>
